{
  "schemaVersion": 1,
  "id": "infinity",
  "name": "Infinite Dimensions",
  "version": "${version}",
  "authors": ["ArchonicCinnamon", "cassiancc"],
  "contact": {
    "homepage": "https://modrinth.com/mod/infinite-dimensions",
    "sources": "https://tangled.org/codexarchonic.nekoweb.org/ProjectInfinity/",
    "issues": "https://tangled.org/codexarchonic.nekoweb.org/ProjectInfinity/"
  },
  "description": "",
  "icon": "assets/infinity/icon.png",
  "license": "MIT",
  "environment": "*",
  "accessWidener": "accesswideners/${aw_file}",
  "entrypoints": {
    "main": [
      "net.codexarchonic.infinity.util.platform.fabric.FabricEntrypoint"
    ],
    "client": [
      "net.codexarchonic.infinity.util.platform.fabric.FabricClientEntrypoint"
    ],
    "modmenu": [
      "net.codexarchonic.infinity.util.platform.fabric.compat.ModMenuCompat"
    ],
    "emi": [
      "net.codexarchonic.infinity.compat.emi.EmiCompat"
    ],
    "rrv": [
      "net.codexarchonic.infinity.compat.rrv.RrvIntegration"
    ],
    "fabric-datagen": [
      "net.codexarchonic.infinity.data.InfinityDataGenerator"
    ]
  },
  "mixins": [
    "infinity.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "architectury": "*"
  },
  "recommends": {
    "cloth-config": "*"
  },
  "custom": {
    "lithium:options": {
      "mixin.ai.poi.fast_portals": false
    }
  }
}